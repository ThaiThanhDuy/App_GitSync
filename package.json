{
  "name": "git-sync-desktop",
  "version": "1.0.0",
  "description": "Track and sync (git pull) multiple GitHub repositories",
  "homepage": "https://github.com/ThaiThanhDuy",
  "main": "src/main/main.js",
  "author": "duy <vuanhs3016s@gmail.com>",
  "license": "MIT",
  "scripts": {
    "start": "node scripts/start.js",
    "build": "node scripts/build.js",
    "build:linux": "node scripts/build.js linux",
    "build:win": "node scripts/build.js win",
    "build:all": "node scripts/build.js all"
  },
  "build": {
    "appId": "com.duy.gitsync",
    "productName": "Git Sync",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Development",
      "maintainer": "duy <vuanhs3016s@gmail.com>",
      "icon": "build/icons"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "deb": {
      "afterInstall": "build/linux-after-install.sh",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "git"
      ]
    }
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  }
}
